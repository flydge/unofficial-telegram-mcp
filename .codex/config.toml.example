[mcp_servers.telegram_search]
command = "/ABSOLUTE/PATH/TO/unofficial-telegram-mcp/.venv/bin/telegram-search-mcp"
args = []
cwd = "/ABSOLUTE/PATH/TO/unofficial-telegram-mcp"
enabled = true
required = true
startup_timeout_sec = 30
tool_timeout_sec = 600
enabled_tools = ["_manifest", "resolve_target", "discover_targets", "search_correspondence", "get_attachment", "get_message_context", "read_attachment", "analyze_media", "create_local_artifact", "begin_local_upload", "append_local_upload", "finish_local_upload", "issue_local_upload_authority", "consume_local_upload_result", "cancel_local_upload_authority", "prepare_reply_artifact_send", "get_reply_artifact_draft", "update_reply_artifact_draft", "refresh_reply_artifact_draft", "prepare_reply_text_send", "get_reply_draft", "update_reply_draft", "refresh_reply_draft", "prepare_text_send", "send_prepared_text", "prepare_artifact_send", "send_prepared_artifact", "read_messages", "read_history", "read_reply_chain", "list_topics", "read_topic_history", "search_messages", "list_chats", "search_chats", "verify_target", "read_target_messages", "read_attachment_page", "read_spreadsheet", "read_presentation", "list_drafts", "get_draft", "get_send_status", "cancel_draft", "update_draft", "refresh_draft", "retain_selection", "prepare_forward_send", "send_prepared_forward", "prepare_video_send", "send_prepared_video"]

# Trusted broker runtime policy is configured separately, not by enabled_tools.
# Bounded media reply targets additionally need reply_media_targets alongside
# send and reply_text_send or reply_artifact_send; legacy defaults omit it.
# Mention/MentionName text reply sources additionally need both default-off
# reply_formatted_targets and reply_identity_targets in that trusted policy.
# Mixed lexical entities also need reply_lexical_targets. Identity media captions
# also require reply_media_targets on supported document/static-photo/voice sources.
# DateTime messageText sources need both default-off reply_formatted_targets and
# reply_datetime_targets, adding lexical/identity capabilities when present.
# DateTime supports signed int32 unix_time with null, exact fieldless Relative or
# closed explicit Absolute precision/weekday evidence; media captions additionally
# require reply_media_targets. Every DateTime overlap remains unsupported.
# Fieldless Url text sources require reply_formatted_targets and reply_url_targets;
# supported Url media captions additionally require reply_media_targets.
# Exact fieldless EmailAddress messageText requires both default-off
# reply_formatted_targets and reply_email_targets; URL/DateTime/lexical/identity
# authority is added exactly when present. Supported EmailAddress media captions
# also require reply_media_targets; v18 reuses reply_email_targets (no new cap).
# Complete escaped covered text is inert evidence; no mailto or email action.
# enabled_tools never grants source or send authority.
# Exact fieldless PhoneNumber messageText requires both default-off
# reply_formatted_targets and reply_phone_targets; add email/URL/DateTime/lexical/
# identity authorities exactly when present. V19 remains messageText only.
# Supported document/static-photo/OGG-voice-note PhoneNumber captions use v20
# and additionally require reply_media_targets; no new capability is added.
# Media helpers retain phone=False. Complete escaped caption spans and stable
# media identity are inert evidence; no dialing, source download or phone action.

# Exact single-message forward/copy requires default-off forward_send alongside send;
# each attempt still needs the local owner dialog and never retries.

# One native MP4/MOV video (at most 64 MiB, metadata probed locally) requires default-off
# video_send alongside send; each attempt needs the local owner dialog and never retries.

# Exact retained-source reuse additionally requires default-off retained_selections.
# It does not enable other readers, recipient selection or send approval.
